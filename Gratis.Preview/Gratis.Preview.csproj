<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);GRATIS_PREVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Gratis/Assets/Fonts/**/*" Link="assets/Fonts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Gratis/Windows/Settings*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../Gratis/Controllers/ZoneSwitchPolicy.cs" Link="Shared/ZoneSwitchPolicy.cs" />
    <Compile Include="../Gratis/Controllers/PlaceIndex.cs;../Gratis/Controllers/PlaceIndexBuilder.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../Gratis/Rendering/*.cs" Exclude="../Gratis/Rendering/DalamudMapDrawContext.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../Gratis/Classes/HoverFlags.cs;../Gratis/Classes/DrawHelpers.cs;../Gratis/Classes/MapShape.cs;../Gratis/Classes/MarkerType.cs;../Gratis/Data/IconSetting.cs;../Gratis/Data/SystemConfig.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
